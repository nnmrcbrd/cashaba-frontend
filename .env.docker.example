# This repository deploys only the frontend. No backend credentials belong here.
FRONTEND_IMAGE=cashaba-frontend:local
NEXT_PUBLIC_API_URL=https://api.example.com/api
NEXT_PUBLIC_PAYMONGO_SUBSCRIPTIONS_ENABLED=false
HTTP_BIND_ADDRESS=127.0.0.1
HTTP_PORT=8081
PUBLIC_BIND_ADDRESS=0.0.0.0
PUBLIC_HTTP_PORT=80
PUBLIC_HTTPS_PORT=443
TLS_CERT_DIR=./docker/tls
