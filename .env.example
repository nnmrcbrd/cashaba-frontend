NEXT_PUBLIC_API_URL="http://localhost:8000/api"
# APK builds use MOBILE_API_URL instead of NEXT_PUBLIC_API_URL. This must be
# reachable from the Android phone; localhost refers to the phone itself.
MOBILE_API_URL="https://api.casha-ba.online/api"
# Set to 1 only when building a debug APK against an HTTP LAN/emulator API.
MOBILE_ALLOW_HTTP="0"
# This flag controls only LIVE recurring subscriptions, not hosted test checkout.
# Hosted test checkout is enabled by the backend's BILLING_MODE=paymongo_test.
NEXT_PUBLIC_PAYMONGO_SUBSCRIPTIONS_ENABLED="false"
